# Event Management System - Version 2.0
# Features: event creation, registration, ticket calculation, event search

events = ["Tech Conference", "Music Festival", "Sports Meet"]

def create_event(event_name, date):
    print("Event", event_name, "created on", date)

def register_attendee(event_name, attendee_name):
    print(attendee_name, "registered for", event_name)

def calculate_ticket_price(quantity, price=500):
    total = quantity * price
    print("Total ticket price = Rs.", total)
    return total

def search_event(event_name):
    if event_name in events:
        print(event_name, "is available")
    else:
        print(event_name, "not found")

